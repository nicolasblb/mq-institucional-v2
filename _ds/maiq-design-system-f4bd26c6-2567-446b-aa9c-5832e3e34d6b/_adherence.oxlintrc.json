        "selector": "JSXOpeningElement[name.name='DimensionBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|max|note|tone|style|key|ref|className|style|children)$/]",
        "message": "<DimensionBar> doesn't accept that prop. Declared props: label, value, max, note, tone, style."
