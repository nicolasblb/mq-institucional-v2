      {
        "selector": "JSXOpeningElement[name.name='InsightCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|source|date|mark|href|style|key|ref|className|style|children)$/]",
        "message": "<InsightCard> doesn't accept that prop. Declared props: title, source, date, mark, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|height|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, height, assetBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:branco|botanico|madeira|menta|app-escuro|app-claro)$/]",
        "message": "<Logo> variant must be one of 'branco' | 'botanico' | 'madeira' | 'menta' | 'app-escuro' | 'app-claro'."
      },
